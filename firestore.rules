rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Users collection:
    // - allow read to all users so nickname uniqueness checks (query by nickname) work without auth
    // - allow write/create for user profiles and onboarding
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
      
      match /{allPaths=**} {
        allow read: if true;
        allow write: if true;
      }
    }
    
    // 2. LisyanConnect P2P Rooms & signaling subcollections
    match /connectRooms/{roomId} {
      allow read, write: if true;
      
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // 3. Wallpapers gallery & Extensions catalog
    match /wallpapers/{wallpaperId} {
      allow read, write: if true;
      
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    match /extensions/{extensionId} {
      allow read, write: if true;
      
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // 4. Fallback: allow read and write across all collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
