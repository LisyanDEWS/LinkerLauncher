rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Users collection and all subcollections (settings, wallpapers, extensions, profile)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 2. LisyanConnect P2P Rooms & signaling subcollections
    match /connectRooms/{roomId} {
      allow read, write: if true;
      
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // 3. Wallpapers gallery & Extensions catalog
    match /wallpapers/{wallpaperId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      match /{allPaths=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /extensions/{extensionId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      match /{allPaths=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // 4. Fallback default rule for authenticated app operations
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

