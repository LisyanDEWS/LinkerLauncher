rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Pillar 1: Global Safety Net - deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Primitive Definition & ID Hardening
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Enforce verified email for all write operations
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    // Every ID must be alphanumeric and bounded in size
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User is owner if the document ID matches their auth UID
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Pillar 2: Validation Blueprints (The "Anti-Update-Gap")
    // Enforces strict schema, type safety, and identity integrity
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'nickname', 'email', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 50
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 100
        && data.updatedAt == request.time;
    }

    // Validation for P2P signalling rooms
    function isValidConnectRoom(data) {
      return data.keys().hasAll(['offer', 'timestamp', 'connected', 'hostCandidates', 'guestCandidates'])
        && data.offer.type is string 
        && data.offer.sdp is string && data.offer.sdp.size() <= 50000
        && data.timestamp == request.time
        && data.connected is bool
        && data.hostCandidates is list && data.hostCandidates.size() <= 100
        && data.guestCandidates is list && data.guestCandidates.size() <= 100;
    }

    // --- User Profile Rules (LinkerID) ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      
      // Pillar 2: Creation validation
      allow create: if isOwner(userId) 
        && isVerified()
        && isValidId(userId)
        && isValidUser(incoming());
      
      // Pillar 4: Tiered Identity / Action-based Updates
      allow update: if isOwner(userId) 
        && isVerified()
        && isValidUser(incoming())
        // Immutable identity fields
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && (
          // Action: Update Settings or Profile
          incoming().diff(existing()).affectedKeys().hasOnly(['nickname', 'settings', 'updatedAt'])
        );
      
      allow delete: if isOwner(userId);
    }

    // --- Connect Room Rules (Lisyan Connect) ---
    match /connectRooms/{roomId} {
      // Pillar 8: Secure List Queries (forbidden for rooms)
      allow list: if false;
      
      allow get: if isSignedIn() && isValidId(roomId);
      
      // Pillar 2: Creation validation
      allow create: if isVerified() 
        && isValidId(roomId)
        && isValidConnectRoom(incoming());
      
      // Action-based Update Pattern
      allow update: if isSignedIn() && isValidId(roomId) && (
        // Action: Join (Add answer)
        (incoming().diff(existing()).affectedKeys().hasOnly(['answer']) 
         && isVerified()
         && incoming().answer.type is string && incoming().answer.sdp is string && incoming().answer.sdp.size() <= 50000)
        ||
        // Action: Signalling (Add ICE candidates)
        (incoming().diff(existing()).affectedKeys().hasOnly(['hostCandidates', 'guestCandidates', 'connected']))
      );
      
      allow delete: if isVerified() && isValidId(roomId);
    }
  }
}
